        <mxCell id="reqName" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#3A3A3C;whiteSpace=wrap;" value="串口私有协议：显示双缓冲接收加本地解包" vertex="1">
