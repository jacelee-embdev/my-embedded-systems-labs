        <mxCell id="apiWrite" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#54708A;fillColor=#FFFFFF;strokeColor=#A8D8FF;strokeWidth=2;spacingLeft=22;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 19px; font-weight: 700;&quot;&gt;buf_write_data() · 通用接口&lt;/span&gt;&lt;br&gt;&lt;br&gt;① 检查 Buffer 非 NULL 且非 FULL&lt;br&gt;② 写入 data[head]&lt;br&gt;③ head = (head + 1) % BUFFER_SIZE&lt;br&gt;④ 当前 UART 路径由 HAL 直接写数组，未调用" vertex="1">
