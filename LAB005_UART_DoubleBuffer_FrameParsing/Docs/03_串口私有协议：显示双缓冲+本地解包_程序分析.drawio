        <mxCell id="apiRead" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#075F99;fillColor=#FFFFFF;strokeColor=#74C4F7;strokeWidth=2;spacingLeft=22;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 19px; font-weight: 700;&quot;&gt;buf_read_data() · 当前解析链使用&lt;/span&gt;&lt;br&gt;&lt;br&gt;① 检查 Buffer、数据状态和输出指针&lt;br&gt;② 读取 *p_data = data[tail]&lt;br&gt;③ tail = (tail + 1) % BUFFER_SIZE&lt;br&gt;④ 成功返回 BUFFER_WR_OK" vertex="1">
