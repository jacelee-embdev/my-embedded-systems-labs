          <mxGeometry height="34" width="220" x="3440" y="983" as="geometry" />
        </mxCell>
        <mxCell id="detailAppBody" parent="1" style="text;html=1;align=left;verticalAlign=top;fontFamily=PingFang SC;fontSize=16;fontColor=#26763C;spacing=5;whiteSpace=wrap;overflow=hidden;" value="① 阻塞等待 packet_ok_queue&#xa;&#xa;② 接收 packet_parser_t *p_parser&#xa;&#xa;③ 读取 p_parser-&gt;parsed_packet.len&#xa;&#xa;④ 遍历 parsed_packet.data[0…len-1]&#xa;&#xa;⑤ 将有效载荷交给业务；当前示例逐字节输出日志" vertex="1">
          <mxGeometry height="250" width="830" x="2820" y="1045" as="geometry" />
        </mxCell>
