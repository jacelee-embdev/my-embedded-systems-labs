        <mxCell id="detailFeedFile" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=SFMono-Regular;fontSize=12;fontColor=#6647B5;fillColor=#EEE8FF;strokeColor=none;" value="App/app.c · static" vertex="1">
          <mxGeometry height="34" width="300" x="1535" y="1388" as="geometry" />
        </mxCell>
        <mxCell id="feedEntry" parent="1" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#6647B5;fillColor=#EEE8FF;strokeColor=none;" value="parser == NULL → ERROR　　否则 switch(frame_state)　　默认返回 IN_PROGRESS" vertex="1">
          <mxGeometry height="52" width="1660" x="180" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="feedH1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#5B4295;fillColor=#FFFFFF;strokeColor=#B8A5F5;strokeWidth=2;spacingLeft=18;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 18px; font-weight: 700;&quot;&gt;RX_WAIT_HEADER_1&lt;/span&gt;&lt;br&gt;&lt;br&gt;① data == 0xFF：进入 HEADER_2&lt;br&gt;② 其他字节：保持当前状态" vertex="1">
          <mxGeometry height="145" width="500" x="180" y="1515" as="geometry" />
        </mxCell>
        <mxCell id="feedH2" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#5B4295;fillColor=#FFFFFF;strokeColor=#B8A5F5;strokeWidth=2;spacingLeft=18;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 18px; font-weight: 700;&quot;&gt;RX_WAIT_HEADER_2&lt;/span&gt;&lt;br&gt;&lt;br&gt;① 0xFE：进入 LENGTH&lt;br&gt;② 0xFF：保持当前状态&lt;br&gt;③ 其他字节：返回 HEADER_1" vertex="1">
          <mxGeometry height="145" width="500" x="760" y="1515" as="geometry" />
        </mxCell>
        <mxCell id="feedLen" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#5B4295;fillColor=#FFFFFF;strokeColor=#B8A5F5;strokeWidth=2;spacingLeft=18;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 18px; font-weight: 700;&quot;&gt;RX_WAIT_LENGTH&lt;/span&gt;&lt;br&gt;&lt;br&gt;① 1…100：保存 len，index 清零&lt;br&gt;② checksum = len，进入 READ_PAYLOAD&lt;br&gt;③ 非法长度：返回 HEADER_1 / ERROR" vertex="1">
          <mxGeometry height="145" width="500" x="1340" y="1515" as="geometry" />
        </mxCell>
        <mxCell id="feedPayload" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#5B4295;fillColor=#FFFFFF;strokeColor=#B8A5F5;strokeWidth=2;spacingLeft=18;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 18px; font-weight: 700;&quot;&gt;RX_READ_PAYLOAD&lt;/span&gt;&lt;br&gt;&lt;br&gt;① 写入 parsed_packet.data[index]&lt;br&gt;② index++；checksum += data&lt;br&gt;③ index ≥ len：进入 READ_CHECK" vertex="1">
          <mxGeometry height="145" width="500" x="180" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="feedCheck" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#5B4295;fillColor=#FFFFFF;strokeColor=#B8A5F5;strokeWidth=2;spacingLeft=18;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 18px; font-weight: 700;&quot;&gt;RX_READ_CHECK&lt;/span&gt;&lt;br&gt;&lt;br&gt;① 比较 data 与 calculated_checksum&lt;br&gt;② 相等：进入 WAIT_TAIL&lt;br&gt;③ 不相等：返回 HEADER_1 / ERROR" vertex="1">
