        <mxCell id="apiCreate" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#075F99;fillColor=#FFFFFF;strokeColor=#74C4F7;strokeWidth=2;spacingLeft=22;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 19px; font-weight: 700;&quot;&gt;create_empty_circular_buf()&lt;/span&gt;&lt;br&gt;&lt;br&gt;① malloc() 分配 circular_buf_t&lt;br&gt;② NULL：记录错误并返回 NULL&lt;br&gt;③ memset() 清零后返回指针" vertex="1">
          <mxGeometry height="155" width="800" x="1970" y="1455" as="geometry" />
        </mxCell>
        <mxCell id="apiStatus" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=16;fontColor=#075F99;fillColor=#FFFFFF;strokeColor=#74C4F7;strokeWidth=2;spacingLeft=22;" value="&lt;span style=&quot;font-family: SFMono-Regular; font-size: 19px; font-weight: 700;&quot;&gt;check_buf_status()&lt;/span&gt;&lt;br&gt;&lt;br&gt;① NULL → BUFFER_NULL&lt;br&gt;② head == tail → BUFFER_EMPTY&lt;br&gt;③ next head == tail → BUFFER_FULL&lt;br&gt;④ 其他情况 → BUFFER_NORMAL" vertex="1">
